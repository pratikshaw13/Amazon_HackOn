# ── AWS Credentials ───────────────────────────────
# IAM user with: AmazonDynamoDBFullAccess, AmazonS3FullAccess, AmazonBedrockFullAccess
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1

# ── S3 ────────────────────────────────────────────
AWS_S3_BUCKET_NAME=secondlife-ai-products

# ── Bedrock AI ────────────────────────────────────
# Region where Bedrock models are available
BEDROCK_REGION=us-east-1
# Amazon Nova Lite — supports text + vision
BEDROCK_TEXT_MODEL=amazon.nova-lite-v1:0
BEDROCK_VISION_MODEL=amazon.nova-lite-v1:0

# ── App ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development


# ── Optional ──────────────────────────────────────
# Real-time demand data via web search
SERPER_API_KEY=your_serper_key_if_available

# ── Auth ──────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256


# ── AI Provider Chain (Multi-Provider Fallback) ───
# Priority order: bedrock → gemini → ollama → fallback
AI_PROVIDER_PRIORITY=bedrock,gemini,ollama,fallback
AI_CONFIDENCE_THRESHOLD=0.6
AI_RETRY_ON_LOW_CONFIDENCE=true

# ── Gemini (Secondary Provider) ──────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ── Local Model via Ollama (Tertiary Provider) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5-vl:7b
OLLAMA_TEXT_MODEL=qwen2.5:7b
USE_LOCAL_MODEL=false
