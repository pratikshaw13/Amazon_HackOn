# ── Gemini AI ─────────────────────────────────────
# Get free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── AWS ───────────────────────────────────────────
# IAM user with DynamoDBFullAccess + S3FullAccess
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=secondlife-ai-products

# ── App ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── Optional ──────────────────────────────────────
# Real-time demand data via web search
SERPER_API_KEY=your_serper_key_if_available
